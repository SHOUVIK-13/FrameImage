# Pass Authorization header to PHP in Apache/FastCGI environments
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
<IfModule mod_setenvif.c>
    SetEnvIfNoCase ^Authorization$ "(.+)" HTTP_AUTHORIZATION=$1
    SetEnvIfNoCase ^X-Admin-Token$ "(.+)" HTTP_X_ADMIN_TOKEN=$1
</IfModule>

# Protect internal storage and JSON cache files
<FilesMatch "^\.|\.json$|\.bak$|\.lock$">
    Order allow,deny
    Deny from all
</FilesMatch>

Options -Indexes
